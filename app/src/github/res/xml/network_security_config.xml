<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration for IPXtream TV.

  Most IPTV providers serve streams over plain HTTP (not HTTPS).
  Without this file, Android 9+ blocks all cleartext HTTP by default.

  This config allows cleartext HTTP ONLY for traffic (stream URLs, API calls).
  Certificate pinning can be added per-domain in a future security hardening pass.
-->
<network-security-config>
    <!-- Allow cleartext for all domains (IPTV servers are typically HTTP) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <!-- Trust the device's built-in CA store -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Fixed third-party hosts are HTTPS only, so no later edit can quietly downgrade them. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <domain includeSubdomains="true">espn.com</domain>
        <domain includeSubdomains="true">espncdn.com</domain>
        <domain includeSubdomains="false">storagebeincom-b4dvftgkaebcayar.z01.azurefd.net</domain>
        <domain includeSubdomains="true">play.google.com</domain>
    </domain-config>
</network-security-config>
